# Kova server settings. Set these in Netlify:
#   Site configuration -> Environment variables
# (for local `netlify dev`, copy to .env - never commit .env)

# ---- required ----------------------------------------------------------
# Firebase service account JSON (Project settings -> Service accounts ->
# Generate new private key). Paste the whole JSON, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=
# Any long random string. Encrypts stored logins. Changing it disconnects
# every linked account. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Your site's public address, no trailing slash. Must match the redirect
# URIs you register with each provider.
PUBLIC_URL=https://your-site.netlify.app
# Only if your database is not the default kova-ee9d5 one
# FIREBASE_DATABASE_URL=https://kova-ee9d5-default-rtdb.firebaseio.com

# ---- assistant, photo meal logging, content engine ---------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_DAILY_LIMIT=60
# AI_DAILY_LIMIT_GUEST=15

# ---- email sign-in codes (resend.com) -----------------------------------
RESEND_API_KEY=
MAIL_FROM=Kova <signin@yourdomain.com>

# ---- food database (free key: api.data.gov/signup) ----------------------
# Without it the USDA DEMO_KEY is used, which is heavily rate limited.
USDA_API_KEY=

# ---- linked accounts: redirect URI for each is
#      https://<your site>/api/callback/<id>   (id in brackets) ----------
GOOGLE_CLIENT_ID=          # [google] Calendar and [youtube] share this app
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=        # [linkedin]
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202601  # YYYYMM, must be a version LinkedIn still supports
X_CLIENT_ID=               # [x]
X_CLIENT_SECRET=
TIKTOK_CLIENT_ID=          # [tiktok]  this is TikTok's "Client key"
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=       # [instagram] "Instagram app ID"
INSTAGRAM_CLIENT_SECRET=

# ---- wearables ------------------------------------------------------------
OURA_CLIENT_ID=            # [oura]
OURA_CLIENT_SECRET=
FITBIT_CLIENT_ID=          # [fitbit]
FITBIT_CLIENT_SECRET=
WHOOP_CLIENT_ID=           # [whoop]
WHOOP_CLIENT_SECRET=
WITHINGS_CLIENT_ID=        # [withings]
WITHINGS_CLIENT_SECRET=
