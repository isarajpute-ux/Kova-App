{%- assign s = section.settings -%}
<section id="nxMem-{{ section.id }}" class="nxMem" style="--bg:{{ s.c_bg }};--acc:{{ s.c_acc }}">
  {%- if s.image != blank -%}<div class="nxMem__bg">{{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: '' }}</div>{%- endif -%}
  <div class="nxMem__in">
    {%- if s.eyebrow != blank -%}<p class="nxMem__ey">{{ s.eyebrow }}</p>{%- endif -%}
    <h2 class="nxMem__h">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="nxMem__p">{{ s.text }}</p>{%- endif -%}
    {%- form 'customer', class: 'nxMem__f' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="nxMem__ok">{{ s.success }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="{{ s.placeholder }}" required aria-label="Email">
        <button type="submit">{{ s.btn }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
<style>
#nxMem-{{ section.id }}{position:relative;overflow:hidden;background:var(--bg);color:#fff;text-align:center;padding:{{ s.pad }}px 20px}
#nxMem-{{ section.id }} .nxMem__bg{position:absolute;inset:0;opacity:.22}
#nxMem-{{ section.id }} .nxMem__bg img{width:100%;height:100%;object-fit:cover;filter:grayscale(1)}
#nxMem-{{ section.id }} .nxMem__in{position:relative;max-width:640px;margin:0 auto}
#nxMem-{{ section.id }} .nxMem__ey{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--acc);margin:0 0 10px}
#nxMem-{{ section.id }} .nxMem__h{color:#fff;font-size:clamp(28px,4vw,46px);font-weight:600;letter-spacing:-.01em;text-transform:uppercase;margin:0 0 10px}
#nxMem-{{ section.id }} .nxMem__p{color:rgba(255,255,255,.75);font-size:15px;margin:0 0 22px}
#nxMem-{{ section.id }} .nxMem__f{display:flex;max-width:520px;margin:0 auto;border:1px solid rgba(255,255,255,.25);border-radius:8px;overflow:hidden;background:rgba(255,255,255,.06)}
#nxMem-{{ section.id }} .nxMem__f input[type=email]{flex:1;min-width:0;background:transparent;border:0;color:#fff;padding:16px 18px;font:inherit;font-size:15px;outline:none}
#nxMem-{{ section.id }} .nxMem__f input::placeholder{color:rgba(255,255,255,.55)}
#nxMem-{{ section.id }} .nxMem__f button{border:0;background:var(--acc);color:#2A1427;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:13px;padding:0 24px;cursor:pointer}
#nxMem-{{ section.id }} .nxMem__ok{padding:16px;margin:0;width:100%;color:var(--acc)}
@media(max-width:749px){#nxMem-{{ section.id }} .nxMem__f button{padding:0 14px;font-size:12px}}
</style>
{% schema %}
{
  "name": "Member signup",
  "tag": "div",
  "settings": [
    {"type":"image_picker","id":"image","label":"Background photo"},
    {"type":"text","id":"eyebrow","label":"Small label","default":"Join the ritual"},
    {"type":"text","id":"heading","label":"Heading","default":"Become a member"},
    {"type":"text","id":"text","label":"Text","default":"Member-only offers, skin tips for women 40+, and early access. No spam, ever."},
    {"type":"text","id":"placeholder","label":"Email placeholder","default":"Your e-mail"},
    {"type":"text","id":"btn","label":"Button","default":"Join now"},
    {"type":"text","id":"success","label":"Success message","default":"You’re in. Welcome to Auvela."},
    {"type":"color","id":"c_bg","label":"Background","default":"#2A1427"},
    {"type":"color","id":"c_acc","label":"Accent","default":"#C7ABFF"},
    {"type":"range","id":"pad","label":"Padding","min":24,"max":140,"step":4,"default":80}
  ],
  "presets":[{"name":"Member signup"}]
}
{% endschema %}
