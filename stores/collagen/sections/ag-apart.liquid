{%- liquid
  assign s = section.settings
-%}
<section id="nx-{{ section.id }}" class="agNx nxA" style="padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px">
  <div class="page-width nxA__w">
    <p class="nxA__ey">{{ s.eyebrow }}</p>
    <h2 class="nxA__h">{{ s.heading }}</h2>
    <div class="nxA__ba" data-nx-ba style="--pos:{{ s.start }}%">
      <div class="nxA__img nxA__after">{%- if s.after != blank -%}{{ s.after | image_url: width: 1400 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
      <div class="nxA__img nxA__before">{%- if s.before != blank -%}{{ s.before | image_url: width: 1400 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
      <span class="nxA__line"><span class="nxA__knob">{% render 'ag-icon', name: 'drag' %}</span></span>
      <span class="nxA__tag nxA__tag--us">✓ {{ s.us_label }}</span>
      <span class="nxA__tag nxA__tag--them">✗ {{ s.them_label }}</span>
      <input type="range" min="0" max="100" value="{{ s.start }}" aria-label="Compare" class="nxA__range">
    </div>
    <ul class="nxA__list">
      {%- for block in section.blocks -%}
        {%- capture ic -%}
          {%- case block.settings.icon -%}
            {%- when 'layers' -%}<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 17.5l9 5 9-5" opacity=".55"/>
            {%- when 'woman' -%}<circle cx="12" cy="6" r="2.6"/><path d="M8.5 21l1.2-6.5L8 11.5c1.2-1.3 2.5-2 4-2s2.8.7 4 2l-1.7 3L15.5 21"/>
            {%- when 'arm' -%}<path d="M4 19c3 .5 7 .2 10-1.5 3-1.7 4.5-4.7 3-7.3-1-1.8-3.3-2.2-4.8-1L11 6.2C10.4 5 9 4.6 7.9 5.3 6.6 6.1 6.5 7.7 7.3 8.8L9 11c-2 1-3.8 2.8-5 5"/>
            {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
            {%- when 'mirror' -%}<ellipse cx="12" cy="10" rx="6" ry="7.5"/><path d="M12 17.5V21M9 21h6M9.5 7.5l2 2"/>
            {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M14 9.5c-.5-.8-1.3-1-2-1-1.2 0-2 .7-2 1.5 0 2 4 1 4 3 0 .9-.9 1.5-2 1.5-.8 0-1.6-.3-2-1M12 7.5v1M12 14.5v1"/>
            {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
            {%- when 'leaf' -%}<path d="M5 19C5 10 10 5 20 4c0 9-5 15-13 15"/><path d="M5 19l8-8"/>
            {%- when 'sparkle' -%}<path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/>
            {%- when 'lines' -%}<path d="M3 6.5c1.5-1.5 3 1.5 4.5 0s3 1.5 4.5 0 3 1.5 4.5 0 3 1.5 4.5 0"/><path d="M3 12c1.5-1 3 1 4.5 0s3 1 4.5 0 3 1 4.5 0 3 1 4.5 0"/><path d="M3 17.5h18"/>
            {%- else -%}<path d="M5 12l4 4 10-10"/>
          {%- endcase -%}
        {%- endcapture -%}
        <li class="nxA__row{% unless block.settings.good %} nxA__row--them{% endunless %}" {{ block.shopify_attributes }}>
          <span class="nxA__ic{% if block.settings.good %} is-ok{% endif %}">{%- if block.settings.good -%}<svg viewBox="0 0 24 24">{{ ic }}</svg>{%- else -%}<svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>{%- endif -%}</span>
          <span><b>{{ block.settings.title }}</b>{%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
#nx-{{ section.id }}{background:#fff;color:#0A0A0A}
#nx-{{ section.id }} .nxA__w{max-width:820px}
#nx-{{ section.id }} .nxA__ey{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:#666;margin:0 0 10px}
#nx-{{ section.id }} .nxA__h{font-size:28px!important;line-height:1.18!important;font-weight:500!important;letter-spacing:-.02em;margin:0 0 26px!important}
#nx-{{ section.id }} .nxA__ba{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:#222;user-select:none}
#nx-{{ section.id }} .nxA__img{position:absolute;inset:0}
#nx-{{ section.id }} .nxA__img img{width:100%;height:100%;object-fit:cover;display:block}
#nx-{{ section.id }} .nxA__before{clip-path:inset(0 0 0 var(--pos))}
#nx-{{ section.id }} .nxA__line{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;background:#fff;transform:translateX(-1px);pointer-events:none}
#nx-{{ section.id }} .nxA__knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;background:#fff;color:#0A0A0A;display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.25)}
#nx-{{ section.id }} .nxA__knob svg{width:18px;height:18px}
#nx-{{ section.id }} .nxA__tag{position:absolute;bottom:14px;font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px;pointer-events:none}
#nx-{{ section.id }} .nxA__tag--us{left:14px;background:{{ s.c_acc }};color:#2A1427}
#nx-{{ section.id }} .nxA__tag--them{right:14px;background:#fff;color:#0A0A0A}
#nx-{{ section.id }} .nxA__range{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
#nx-{{ section.id }} .nxA__list{list-style:none;margin:24px 0 0;padding:0;background:#F6F1FF;border-radius:14px;overflow:hidden}
#nx-{{ section.id }} .nxA__row{display:flex;gap:16px;align-items:center;padding:16px 22px;border-bottom:1px solid #E7DDFB}
#nx-{{ section.id }} .nxA__row--them{background:#fff}
#nx-{{ section.id }} .nxA__row:last-child{border-bottom:0}
#nx-{{ section.id }} .nxA__row b{display:block;font-weight:500;font-size:16px;color:#2A1427}
#nx-{{ section.id }} .nxA__row small{display:block;font-size:13.5px;color:#6E5F69;margin-top:2px}
#nx-{{ section.id }} .nxA__ic{flex:0 0 42px;width:42px;height:42px;border-radius:50%;background:#EAEAEA;color:#8A8A8A;display:grid;place-items:center}
#nx-{{ section.id }} .nxA__ic.is-ok{background:{{ s.c_acc }};color:#2A1427}
#nx-{{ section.id }} .nxA__ic svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
@media(max-width:749px){#nx-{{ section.id }} .nxA__row{padding:13px 16px;gap:12px}#nx-{{ section.id }} .nxA__ic{flex-basis:36px;width:36px;height:36px}#nx-{{ section.id }} .nxA__ic svg{width:18px;height:18px}#nx-{{ section.id }} .nxA__row b{font-size:15px}}
@media(min-width:990px){#nx-{{ section.id }} .nxA__h{font-size:40px!important}}
</style>
<script>
(function(){var r=document.querySelector('#nx-{{ section.id }} [data-nx-ba]');if(!r)return;var i=r.querySelector('input');i.addEventListener('input',function(){r.style.setProperty('--pos',i.value+'%')});})();
</script>
{% schema %}
{
  "name": "What sets us apart",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "What sets us apart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What sets us apart." },
    { "type": "image_picker", "id": "after", "label": "Left image (with us)" },
    { "type": "image_picker", "id": "before", "label": "Right image (the other way)" },
    { "type": "text", "id": "us_label", "label": "Left tag", "default": "Our collagen" },
    { "type": "text", "id": "them_label", "label": "Right tag", "default": "Ordinary collagen" },
    { "type": "range", "id": "start", "label": "Slider start %", "min": 10, "max": 90, "step": 5, "default": 50 },
    { "type": "color", "id": "c_acc", "label": "Icon / tag colour", "default": "#C7ABFF" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [
    { "type": "checkbox", "id": "good", "label": "Us (icon) — untick for them (grey ✗)", "default": true },
    { "type": "select", "id": "icon", "label": "Icon (us rows)", "default": "check", "options": [
      { "value": "layers", "label": "Layers (full-spectrum)" }, { "value": "woman", "label": "Woman (made for 40+)" }, { "value": "arm", "label": "Toned arm (the look)" },
      { "value": "mirror", "label": "Mirror" }, { "value": "heart", "label": "Heart (the feeling)" }, { "value": "shield", "label": "Money-back shield" },
      { "value": "drop", "label": "Hydration drop" }, { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "lines", "label": "Smoothing lines" }, { "value": "check", "label": "Check" } ] },
    { "type": "text", "id": "title", "label": "Title", "default": "Opens wider" },
    { "type": "text", "id": "text", "label": "Sub text" } ] } ],
  "presets": [ { "name": "What sets us apart" } ]
}
{% endschema %}
