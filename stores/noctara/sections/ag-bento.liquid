{%- liquid
  assign s = section.settings
-%}
<section id="nx-{{ section.id }}" class="agNx nxBn" style="padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px">
  <div class="page-width">
    <p class="nxBn__ey">{{ s.eyebrow }}</p>
    <h2 class="nxBn__h">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="nxBn__p">{{ s.text }}</p>{%- endif -%}
    <div class="nxBn__grid">
      {%- for block in section.blocks limit: 3 -%}
        <div class="nxBn__tile nxBn__tile--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}{{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
          {%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{%- endif -%}
          {%- if block.settings.tag != blank -%}<span class="nxBn__tag">{{ block.settings.tag }}</span>{%- endif -%}
          <h3 class="nxBn__t">{{ block.settings.title }} <em>{{ block.settings.italic }}</em></h3>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#nx-{{ section.id }}{background:#fff;color:#0A0A0A;text-align:center}
#nx-{{ section.id }} .nxBn__ey{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:#666;margin:0 0 12px}
#nx-{{ section.id }} .nxBn__h{font-size:34px!important;font-weight:500!important;letter-spacing:-.03em;line-height:1.08!important;margin:0 0 14px!important}
#nx-{{ section.id }} .nxBn__p{font-size:15px;line-height:1.6;color:#777;max-width:640px;margin:0 auto 32px}
#nx-{{ section.id }} .nxBn__grid{display:grid;gap:12px;text-align:left}
#nx-{{ section.id }} .nxBn__tile{position:relative;border-radius:16px;overflow:hidden;background:radial-gradient(70% 60% at 60% 40%,#1c2a44,#0A0A0A);aspect-ratio:16/10}
#nx-{{ section.id }} .nxBn__tile--3{aspect-ratio:4/5}
#nx-{{ section.id }} .nxBn__tile video,#nx-{{ section.id }} .nxBn__tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#nx-{{ section.id }} .nxBn__tile:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.55))}
#nx-{{ section.id }} .nxBn__tag{position:absolute;z-index:1;top:16px;left:16px;font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#9CC2FF;background:rgba(43,123,255,.18);border:1px solid rgba(43,123,255,.35);padding:6px 12px;border-radius:999px;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
#nx-{{ section.id }} .nxBn__t{position:absolute;z-index:1;left:20px;right:20px;bottom:18px;color:#fff;font-size:22px!important;font-weight:500!important;letter-spacing:-.01em;margin:0!important}
#nx-{{ section.id }} .nxBn__t em{font-style:italic;font-weight:400}
@media(min-width:990px){#nx-{{ section.id }} .nxBn__h{font-size:60px!important}#nx-{{ section.id }} .nxBn__grid{grid-template-columns:1.5fr 1fr;grid-template-rows:1fr 1fr;max-width:1200px;margin:0 auto}#nx-{{ section.id }} .nxBn__tile{aspect-ratio:auto;min-height:340px}#nx-{{ section.id }} .nxBn__tile--3{grid-column:2;grid-row:1/3}#nx-{{ section.id }} .nxBn__t{font-size:30px!important;left:26px;bottom:24px}}
</style>
{% schema %}
{
  "name": "Video grid (bento)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The system" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two parts. One click." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 64 }
  ],
  "blocks": [ { "type": "tile", "name": "Tile", "limit": 3, "settings": [
    { "type": "video", "id": "video", "label": "Video" }, { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Reusable" }, { "type": "text", "id": "title", "label": "Title", "default": "Strong magnetic" }, { "type": "text", "id": "italic", "label": "Italic word(s)", "default": "band" } ] } ],
  "presets": [ { "name": "Video grid (bento)", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
