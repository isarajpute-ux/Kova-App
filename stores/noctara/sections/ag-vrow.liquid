{%- liquid
  assign s = section.settings
-%}
<section id="nx-{{ section.id }}" class="agNx nxVr" style="padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px">
  <div class="page-width nxVr__hd">
    <div>
      {%- if s.eyebrow != blank -%}<p class="nxVr__ey">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="nxVr__h">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="nxVr__p">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="nxVr__nav"><button type="button" data-p aria-label="Previous">{% render 'ag-icon', name: 'chevron-left' %}</button><button type="button" data-n aria-label="Next">{% render 'ag-icon', name: 'chevron-right' %}</button></div>
  </div>
  <div class="nxVr__track" data-t>
    {%- for block in section.blocks -%}
      <div class="nxVr__card" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
          <button type="button" class="nxVr__snd" aria-label="Sound"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path class="x" d="m16 9.5 5 5M21 9.5l-5 5"/><path class="w" d="M15.5 9a4 4 0 0 1 0 6"/></svg></button>
        {%- else -%}<div class="nxVr__ph">Add video</div>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
<style>
#nx-{{ section.id }}{background:#fff;color:#0A0A0A}
#nx-{{ section.id }} .nxVr__hd{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:26px}
#nx-{{ section.id }} .nxVr__ey{font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;color:#666;margin:0 0 10px}
#nx-{{ section.id }} .nxVr__h{font-size:32px!important;margin:0 0 8px!important}
#nx-{{ section.id }} .nxVr__p{font-size:15.5px;color:#6E6E6E;margin:0}
#nx-{{ section.id }} .nxVr__nav{display:flex;gap:10px;flex-shrink:0}
#nx-{{ section.id }} .nxVr__nav button{width:52px;height:52px;border-radius:50%;border:1px solid #DADADA;background:#fff;display:grid;place-items:center;cursor:pointer;padding:0;color:#0A0A0A}
#nx-{{ section.id }} .nxVr__nav svg{width:18px;height:18px}
#nx-{{ section.id }} .nxVr__track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 1.5rem;scroll-padding:0 1.5rem}
#nx-{{ section.id }} .nxVr__track::-webkit-scrollbar{display:none}
#nx-{{ section.id }} .nxVr__card{position:relative;flex:0 0 72%;aspect-ratio:9/16;border-radius:18px;overflow:hidden;background:radial-gradient(70% 60% at 50% 35%,#2a3346,#0A0A0A);scroll-snap-align:start}
#nx-{{ section.id }} .nxVr__card video{width:100%;height:100%;object-fit:cover}
#nx-{{ section.id }} .nxVr__ph{height:100%;display:grid;place-items:center;color:#777;font-size:13px}
#nx-{{ section.id }} .nxVr__snd{position:absolute;top:14px;right:14px;width:40px;height:40px;border-radius:50%;border:0;background:rgba(20,20,20,.55);color:#fff;display:grid;place-items:center;cursor:pointer;padding:0;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
#nx-{{ section.id }} .nxVr__snd svg{width:18px;height:18px}
#nx-{{ section.id }} .nxVr__snd .w{display:none}
#nx-{{ section.id }} .nxVr__snd.on .w{display:block}#nx-{{ section.id }} .nxVr__snd.on .x{display:none}
@media(max-width:749px){#nx-{{ section.id }} .nxVr__nav{display:none}}
@media(min-width:990px){#nx-{{ section.id }} .nxVr__h{font-size:52px!important}#nx-{{ section.id }} .nxVr__track{padding:0 5rem;scroll-padding:0 5rem}#nx-{{ section.id }} .nxVr__card{flex-basis:calc((100% - 48px)/4.15)}}
</style>
<script>(function(){var r=document.getElementById('nx-{{ section.id }}');if(!r)return;var t=r.querySelector('[data-t]'),c=function(){var x=t.querySelector('.nxVr__card');return x?x.offsetWidth+16:300};r.querySelector('[data-p]').onclick=function(){t.scrollBy({left:-c(),behavior:'smooth'})};r.querySelector('[data-n]').onclick=function(){t.scrollBy({left:c(),behavior:'smooth'})};r.querySelectorAll('.nxVr__snd').forEach(function(b){b.onclick=function(){var v=b.parentNode.querySelector('video');if(!v)return;r.querySelectorAll('video').forEach(function(o){if(o!==v){o.muted=true}});r.querySelectorAll('.nxVr__snd').forEach(function(o){if(o!==b)o.classList.remove('on')});v.muted=!v.muted;b.classList.toggle('on',!v.muted)}})})();</script>
{% schema %}
{
  "name": "Video row",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "From the field" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real people. <em>Real sweat.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Noctara in training, sleep and everything in between." },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "default": 72 }
  ],
  "blocks": [ { "type": "video", "name": "Video", "settings": [ { "type": "video", "id": "video", "label": "Video" } ] } ],
  "presets": [ { "name": "Video row", "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" } ] } ]
}
{% endschema %}
