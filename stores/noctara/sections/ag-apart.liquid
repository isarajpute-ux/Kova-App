{%- liquid
  assign s = section.settings
-%}
<section id="nx-{{ section.id }}" class="agNx nxA" style="padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px">
  <div class="page-width nxA__w">
    <p class="nxA__ey">{{ s.eyebrow }}</p>
    <h2 class="nxA__h">{{ s.heading }}</h2>
    <div class="nxA__ba" data-nx-ba style="--pos:{{ s.start }}%">
      <div class="nxA__img nxA__after">{%- if s.after != blank -%}{{ s.after | image_url: width: 1400 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
      <div class="nxA__img nxA__before">{%- if s.before != blank -%}{{ s.before | image_url: width: 1400 | image_tag: loading: 'lazy' }}{%- endif -%}</div>
      <span class="nxA__line"><span class="nxA__knob">{% render 'ag-icon', name: 'drag' %}</span></span>
      <span class="nxA__tag nxA__tag--us">✓ {{ s.us_label }}</span>
      <span class="nxA__tag nxA__tag--them">✗ {{ s.them_label }}</span>
      <input type="range" min="0" max="100" value="{{ s.start }}" aria-label="Compare" class="nxA__range">
    </div>
    <ul class="nxA__list">
      {%- for block in section.blocks -%}
        <li class="nxA__row" {{ block.shopify_attributes }}>
          <span class="nxA__ic{% if block.settings.good %} is-ok{% endif %}">{% if block.settings.good %}{% render 'ag-icon', name: 'check' %}{% else %}{% render 'ag-icon', name: 'close' %}{% endif %}</span>
          <span><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
#nx-{{ section.id }}{background:#fff;color:#0A0A0A}
#nx-{{ section.id }} .nxA__w{max-width:820px}
#nx-{{ section.id }} .nxA__ey{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:#666;margin:0 0 10px}
#nx-{{ section.id }} .nxA__h{font-size:28px!important;line-height:1.18!important;font-weight:500!important;letter-spacing:-.02em;margin:0 0 26px!important}
#nx-{{ section.id }} .nxA__ba{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#222;user-select:none}
#nx-{{ section.id }} .nxA__img{position:absolute;inset:0}
#nx-{{ section.id }} .nxA__img img{width:100%;height:100%;object-fit:cover;display:block}
#nx-{{ section.id }} .nxA__before{clip-path:inset(0 0 0 var(--pos))}
#nx-{{ section.id }} .nxA__line{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;background:#fff;transform:translateX(-1px);pointer-events:none}
#nx-{{ section.id }} .nxA__knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;background:#fff;color:#0A0A0A;display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.25)}
#nx-{{ section.id }} .nxA__knob svg{width:18px;height:18px}
#nx-{{ section.id }} .nxA__tag{position:absolute;bottom:14px;font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px;pointer-events:none}
#nx-{{ section.id }} .nxA__tag--us{left:14px;background:{{ s.c_acc }};color:#0A0A0A}
#nx-{{ section.id }} .nxA__tag--them{right:14px;background:#fff;color:#0A0A0A}
#nx-{{ section.id }} .nxA__range{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
#nx-{{ section.id }} .nxA__list{list-style:none;margin:28px 0 0;padding:0;background:#F6F6F6;border-radius:14px;overflow:hidden}
#nx-{{ section.id }} .nxA__row{display:flex;gap:16px;align-items:flex-start;padding:18px 22px;border-bottom:1px solid #E6E6E6}
#nx-{{ section.id }} .nxA__row:last-child{border-bottom:0}
#nx-{{ section.id }} .nxA__row b{display:block;font-weight:500;font-size:15px}
#nx-{{ section.id }} .nxA__row small{display:block;font-size:13.5px;color:#777;margin-top:3px}
#nx-{{ section.id }} .nxA__ic{flex:0 0 26px;height:26px;border-radius:50%;background:#E2E2E2;color:#777;display:grid;place-items:center}
#nx-{{ section.id }} .nxA__ic.is-ok{background:{{ s.c_acc }};color:#0A0A0A}
#nx-{{ section.id }} .nxA__ic svg{width:13px;height:13px;stroke-width:3}
@media(min-width:990px){#nx-{{ section.id }} .nxA__h{font-size:40px!important}#nx-{{ section.id }} .nxA__w{max-width:960px}#nx-{{ section.id }} .nxA__list{display:grid;grid-template-columns:1fr 1fr;grid-auto-flow:row}#nx-{{ section.id }} .nxA__row:nth-child(odd){border-right:1px solid #E6E6E6}#nx-{{ section.id }} .nxA__row:nth-last-child(-n+2){border-bottom:0}}
</style>
<script>
(function(){var r=document.querySelector('#nx-{{ section.id }} [data-nx-ba]');if(!r)return;var i=r.querySelector('input');i.addEventListener('input',function(){r.style.setProperty('--pos',i.value+'%')});})();
</script>
{% schema %}
{
  "name": "What sets us apart",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "What sets us apart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opens wider, holds stronger, and never collapses." },
    { "type": "image_picker", "id": "after", "label": "Left image (with us)" },
    { "type": "image_picker", "id": "before", "label": "Right image (the other way)" },
    { "type": "text", "id": "us_label", "label": "Left tag", "default": "With Noctara" },
    { "type": "text", "id": "them_label", "label": "Right tag", "default": "Nasal strip" },
    { "type": "range", "id": "start", "label": "Slider start %", "min": 10, "max": 90, "step": 5, "default": 85 },
    { "type": "color", "id": "c_acc", "label": "Tick / tag colour", "default": "#18E08A" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [ { "type": "checkbox", "id": "good", "label": "✓ (us)  — untick for ✗ (them)", "default": true }, { "type": "text", "id": "title", "label": "Title", "default": "Opens wider" }, { "type": "text", "id": "text", "label": "Sub text", "default": "Short explanation" } ] } ],
  "presets": [ { "name": "What sets us apart" } ]
}
{% endschema %}
