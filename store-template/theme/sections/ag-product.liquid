{%- liquid
  assign s = section.settings
  assign cv = product.selected_or_first_available_variant
  assign form_id = 'agForm-' | append: section.id
  assign default_qty = 1
  assign default_save = 0
  for block in section.blocks
    if block.type == 'bundle' and block.settings.is_default
      assign default_qty = block.settings.qty
      assign default_save = block.settings.save_pct
    endif
  endfor
  assign cmp = cv.compare_at_price | default: 0
  case s.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '5 / 4'
    else
      assign ratio = '1 / 1'
  endcase
  case s.pill_av_shape
    when 'circle'
      assign pill_r = '50%'
    when 'rounded'
      assign pill_r = '30%'
    else
      assign pill_r = '3px'
  endcase
  case s.mr_shape
    when 'circle'
      assign mr_r = '50%'
    when 'rounded'
      assign mr_r = '10px'
    else
      assign mr_r = '0'
  endcase
-%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
{{ 'ag-video.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.font_family | default: 'Poppins' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap">
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ag-sternify.js' | asset_url }}" defer="defer"></script>
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--ag-bg:{{ s.c_bg }};--ag-ink:{{ s.c_ink }};--ag-muted:{{ s.c_muted }};--ag-title:{{ s.c_title }};--ag-wine:{{ s.c_btn }};--ag-wine2:{{ s.c_btn2 }};--ag-soft:{{ s.c_soft }};--ag-line:{{ s.c_line }};--ag-red:{{ s.c_red }};--ag-star:{{ s.c_star }};--ag-gold:{{ s.c_gold }};--ag-hl:{{ s.c_highlight }};--ag-bundle-bg:{{ s.c_bundle }};--deal-bg:{{ s.deal_bg }};--deal-c:{{ s.deal_color }};--deal-code-bg:{{ s.deal_code_bg }};--spots-c:{{ s.spots_color }};--ag-radius:{{ s.radius }}px;--ag-ratio:{{ ratio }};--ag-title-m:{{ s.title_size_m }}px;--ag-title-d:{{ s.title_size_d }}px;--ag-pill-w:{{ s.pill_av_w }}px;--ag-pill-h:{{ s.pill_av_h }}px;--ag-pill-r:{{ pill_r }};--ag-pill-bw:{{ s.pill_av_border }}px;--ag-pill-bc:{{ s.pill_av_border_color }};--mr-w:{{ s.mr_w }}px;--mr-h:{{ s.mr_h }}px;--mr-r:{{ mr_r }};--mr-bw:{{ s.mr_border }}px;--mr-bc:{{ s.mr_border_color }};--mr-av-bg:{{ s.mr_av_bg }};--mr-av-c:{{ s.mr_av_text }};--mr-name-c:{{ s.mr_name_color }};--mr-name-s:{{ s.mr_name_size }}px;--mr-text-c:{{ s.mr_text_color }};--mr-text-s:{{ s.mr_text_size }}px;--mr-ver-c:{{ s.mr_ver_color }};--mr-bg:{{ s.mr_bg }};--mr-line:{{ s.mr_line }};--mr-arrow-bg:{{ s.mr_arrow_bg }};--mr-arrow-c:{{ s.mr_arrow_color }};padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
</style>

<section id="ag-{{ section.id }}" class="agS agP" data-ag-product data-money-format="{{ shop.money_format | strip_html | escape }}" data-price="{{ cv.price }}" data-compare="{{ cmp }}" data-available="{{ cv.available }}" data-sold-out="{{ s.soldout_text | escape }}" data-show-compare="{{ s.show_compare }}">
  <div class="agWrap">
    <div class="agP__grid">

      {%- comment -%} ========== GALLERY ========== {%- endcomment -%}
      <div class="agP__media">
        <div class="agP__stage{% unless s.show_side_cards %} agP__stage--solo{% endunless %}">
          <div class="agP__main">
            <div class="agP__track" data-ag-track>
              {%- for media in product.media -%}
                <div class="agP__slide" data-index="{{ forloop.index0 }}">
                  {%- if media.media_type == 'image' -%}
                    {%- liquid
                      if forloop.first
                        assign lz = 'eager'
                      else
                        assign lz = 'lazy'
                      endif
                      assign malt = media.alt | default: product.title | escape
                    -%}
                    {{ media | image_url: width: 1400 | image_tag: loading: lz, widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 46vw, 100vw', alt: malt, class: 'agP__img' }}
                  {%- else -%}
                    {{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true }}
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="agP__slide">{{ 'product-1' | placeholder_svg_tag: 'agP__ph' }}</div>
              {%- endfor -%}
            </div>
            {%- if product.media.size > 1 -%}
              <button type="button" class="agP__arrow agP__arrow--prev" data-ag-prev aria-label="Previous image">{% render 'ag-icon', name: 'chevron-left', stroke: 2 %}</button>
              <button type="button" class="agP__arrow agP__arrow--next" data-ag-next aria-label="Next image">{% render 'ag-icon', name: 'chevron-right', stroke: 2 %}</button>
            {%- endif -%}
          </div>

          {%- if s.show_side_cards -%}
            <div class="agP__side">
              {%- for block in section.blocks -%}
                {%- if block.type == 'side_card' -%}
                  <div class="agP__sideCard" {{ block.shopify_attributes }}>
                    <span class="agP__sideIc" style="color:{{ block.settings.icon_color }}">{% render 'ag-icon', name: block.settings.icon %}</span>
                    <strong>{{ block.settings.title }}</strong>
                    <span class="sub">{{ block.settings.sub }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if s.show_thumbs and product.media.size > 1 -%}
          <div class="agP__thumbs">
            <button type="button" class="agP__thumbNav" data-ag-tprev aria-label="Scroll thumbnails left">{% render 'ag-icon', name: 'chevron-left' %}</button>
            <div class="agP__thumbTrack" data-ag-thumbs>
              {%- for media in product.media -%}
                <button type="button" class="agP__thumb{% if forloop.first %} is-active{% endif %}" data-ag-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
            <button type="button" class="agP__thumbNav" data-ag-tnext aria-label="Scroll thumbnails right">{% render 'ag-icon', name: 'chevron-right' %}</button>
          </div>
        {%- endif -%}

        {%- if s.show_callout and s.callout_text != blank -%}
          <div class="agP__callout agOnlyD">
            <span class="agP__calloutIc">{% render 'ag-icon', name: s.callout_icon %}</span>
            <div>{{ s.callout_text }}</div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ========== BUY BOX ========== {%- endcomment -%}
      <div class="agP__info">
        <div class="agP__rating">
          {% render 'ag-stars', rating: s.rating %}
          {%- if s.reviews_text != blank -%}<a href="{{ s.reviews_link | default: '#agReviews' }}" class="agP__rlink">{{ s.reviews_text }}</a>{%- endif -%}
        </div>

        <h1 class="agP__title">{{ s.title_override | default: product.title }}</h1>

        {%- if s.desc != blank -%}<div class="agP__desc">{{ s.desc }}</div>{%- endif -%}

        {%- if s.show_pill -%}
          <div class="agP__pill">
            <span class="agP__pillAv">
              {%- if s.pill_avatar != blank -%}
                {{ s.pill_avatar | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- elsif product.featured_media -%}
                {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span>{{ s.pill_text }}</span>
          </div>
        {%- endif -%}

        <div class="agP__priceRow">
          <span class="agP__price" data-ag-price>{{ cv.price | money }}</span>
          {%- liquid
            assign show_cmp = false
            if s.show_compare and cmp > cv.price
              assign show_cmp = true
              assign off = cmp | minus: cv.price | times: 100 | divided_by: cmp
            endif
          -%}
          <s class="agP__compare" data-ag-compare{% unless show_cmp %} hidden{% endunless %}>{% if show_cmp %}{{ cmp | money }}{% endif %}</s>
          <span class="agP__off" data-ag-off{% unless show_cmp %} hidden{% endunless %}>{% if show_cmp %}-{{ off }}%{% endif %}</span>
        </div>
        {%- if s.bubble_text != blank -%}<div class="agP__bubble">{{ s.bubble_text }}</div>{%- endif -%}
        {%- if s.show_deal -%}
          <div class="agDeal" data-ag-deal data-hours="{{ s.deal_hours }}">
            <div class="agDeal__t"><span class="agDeal__ic">{% render 'ag-icon', name: 'clock', stroke: 2 %}</span><span>{{ s.deal_text }}</span> <b class="agDeal__clock" data-deal-clock>{{ s.deal_hours | prepend: '0' | slice: -2, 2 }}:00:00</b></div>
            {%- if s.deal_code != blank -%}<button type="button" class="agDeal__code" data-ag-copy="{{ s.deal_code | escape }}" data-copied="{{ s.deal_copied | escape }}" aria-label="Copy code {{ s.deal_code | escape }}"><span data-copy-label>{{ s.deal_code }}</span>{% render 'ag-icon', name: 'copy' %}</button>{%- endif -%}
          </div>
        {%- endif -%}

        {%- capture benefits -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li class="agP__benefit" {{ block.shopify_attributes }}><span style="color:{{ block.settings.icon_color }}">{% render 'ag-icon', name: block.settings.icon %}</span><span>{{ block.settings.text }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if benefits != blank -%}<ul class="agP__benefits">{{ benefits }}</ul>{%- endif -%}

        {%- if s.show_mr -%}
          {%- capture slides -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mini_review' -%}
                <div class="agMR__slide" {{ block.shopify_attributes }}>
                  <div class="agMR__img">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.name }}
                    {%- else -%}
                      {%- assign nm = block.settings.name | split: ' ' -%}
                      <span class="agMR__ini">{{ nm[0] | slice: 0 }}{{ nm[1] | slice: 0 }}</span>
                    {%- endif -%}
                  </div>
                  <div class="agMR__body">
                    <div class="agMR__head"><strong class="agMR__name">{{ block.settings.name }}</strong>{% render 'ag-stars', rating: block.settings.rating, star_color: s.mr_star_color, star_size: s.mr_star_size %}</div>
                    {%- if s.mr_show_verified and s.mr_ver_text != blank -%}<span class="agMR__ver">{% render 'ag-icon', name: s.mr_ver_icon %}{{ s.mr_ver_text }}</span>{%- endif -%}
                    <p class="agMR__text">{{ block.settings.text }}</p>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if slides != blank -%}
            <div class="agMR agMR--{{ s.mr_style }}" id="agReviews" data-ag-mr data-autoplay="{{ s.mr_autoplay }}" data-speed="{{ s.mr_speed }}">
              <button type="button" class="agMR__nav agMR__nav--prev" data-mr-prev aria-label="Previous review">{% render 'ag-icon', name: 'chevron-left', stroke: 2 %}</button>
              <div class="agMR__viewport"><div class="agMR__track" data-mr-track>{{ slides }}</div></div>
              <button type="button" class="agMR__nav agMR__nav--next" data-mr-next aria-label="Next review">{% render 'ag-icon', name: 'chevron-right', stroke: 2 %}</button>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="agP__opt">
            <div class="agP__optLabel"><strong>{{ s.variant_label | default: product.options.first }}</strong> – <span data-ag-vlabel>{{ cv.title }}</span></div>
            <div class="agP__pills agP__pills--{{ s.pill_style }}" role="radiogroup" aria-label="{{ product.options.first | escape }}">
              {%- for v in product.variants -%}
                <button type="button" role="radio" aria-checked="{% if v.id == cv.id %}true{% else %}false{% endif %}" class="agP__pillBtn{% if v.id == cv.id %} is-active{% endif %}" data-ag-variant="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ v.compare_at_price | default: 0 }}" data-available="{{ v.available }}" data-title="{{ v.title | escape }}"{% if v.featured_media %} data-media="{{ v.featured_media.position | minus: 1 }}"{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endunless -%}

        {%- if s.show_stock and s.stock_text != blank -%}
          <p class="agP__stock{% if s.stock_glow %} is-glow{% endif %}"><span class="agP__dot"></span>{{ s.stock_text }}</p>
        {%- endif -%}
        {%- if s.show_spots and s.spots_text != blank -%}
          {%- liquid
            assign spots_pct = s.spots_count | times: 100 | divided_by: s.spots_total
            if spots_pct > 100
              assign spots_pct = 100
            endif
          -%}
          <div class="agSpots">
            <p class="agSpots__t">{% render 'ag-icon', name: 'bolt', stroke: 2 %}<span>{{ s.spots_text | replace: '[n]', s.spots_count }}</span></p>
            {%- if s.spots_bar -%}<div class="agSpots__bar" aria-hidden="true"><span style="width:{{ spots_pct }}%"></span></div>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_bundles -%}
          {%- capture bundles -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'bundle' -%}
                {%- liquid
                  assign bq = block.settings.qty
                  assign keep = 100 | minus: block.settings.save_pct
                  assign btotal = cv.price | times: bq | times: keep | divided_by: 100
                  assign bunit = cv.price
                  if cmp > cv.price
                    assign bunit = cmp
                  endif
                  assign bbase = bunit | times: bq
                -%}
                <label class="agB__card{% if block.settings.is_default %} is-active{% endif %}" data-ag-bundle data-qty="{{ bq }}" data-save="{{ block.settings.save_pct }}" {{ block.shopify_attributes }}>
                  <input type="radio" name="agBundle-{{ section.id }}" value="{{ bq }}"{% if block.settings.is_default %} checked{% endif %}>
                  <span class="agB__img">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                    {%- elsif product.featured_media -%}
                      {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    {%- if bq > 1 -%}<em class="agB__x">×{{ bq }}</em>{%- endif -%}
                  </span>
                  <span class="agB__txt"><strong>{{ block.settings.title }}</strong><small>{{ block.settings.sub }}</small></span>
                  <span class="agB__price"><b data-ag-bprice>{{ btotal | money }}</b><s data-ag-bcompare{% unless bbase > btotal %} hidden{% endunless %}>{{ bbase | money }}</s></span>
                  {%- if block.settings.badge != blank -%}<span class="agB__badge" style="background:{{ block.settings.badge_color }}">{{ block.settings.badge }}</span>{%- endif -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if bundles != blank -%}
            <div class="agB" role="radiogroup" aria-label="{{ s.bundle_heading | escape }}">
              {%- if s.bundle_heading != blank -%}<div class="agB__head"><span>{{ s.bundle_heading }}</span></div>{%- endif -%}
              {{ bundles }}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- liquid
          assign keep0 = 100 | minus: default_save
          assign atc_total = cv.price | times: default_qty | times: keep0 | divided_by: 100
        -%}
        <product-form class="agP__form" data-section-id="{{ section.id }}" data-hide-errors="false">
          {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ cv.id }}" class="product-variant-id" data-ag-id>
            <input type="hidden" name="quantity" value="{{ default_qty }}" data-ag-qty>
            <div class="product-form__error-message-wrapper agP__err" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            <button type="submit" name="add" class="agP__atc" data-ag-atc{% unless cv.available %} disabled{% endunless %}>
              <span data-ag-atc-label>{%- if cv.available -%}{{ s.atc_text }}{%- if s.atc_show_price -%} <i class="agP__sep">•</i> <span data-ag-atc-price>{{ atc_total | money }}</span>{%- endif -%}{%- else -%}{{ s.soldout_text }}{%- endif -%}</span>
              <div class="loading__spinner hidden"><svg class="agSpin" viewBox="0 0 66 66" aria-hidden="true"><circle stroke-width="6" cx="33" cy="33" r="30" fill="none" stroke="currentColor" stroke-dasharray="140" stroke-linecap="round"></circle></svg></div>
            </button>
            {%- if s.show_dynamic_checkout -%}<div class="agP__dyn">{{ form | payment_button }}</div>{%- endif -%}
          {%- endform -%}
        </product-form>

        {%- if s.ship_text != blank -%}<p class="agP__ship">{{ s.ship_text }}</p>{%- endif -%}

        {%- if s.show_payment -%}
          <ul class="agP__pay" aria-label="Payment methods">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'agP__payIc' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.loved_text != blank -%}
          <div class="agP__loved"><p>{{ s.loved_text }}</p>{% render 'ag-stars', rating: 5, star_color: s.c_gold, star_size: 14 %}</div>
        {%- endif -%}

        {%- if s.show_ugc -%}
          {%- capture ugc -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'ugc' -%}
                <div class="agP__ugcItem{% if block.settings.video != blank %} agP__ugcItem--vid{% endif %}" data-ag-vcard {{ block.shopify_attributes }}>
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '480x', class: 'agVid' }}
                    <span class="agVid__snd" aria-hidden="true"><span class="off">{% render 'ag-icon', name: 'sound-off', stroke: 2 %}</span><span class="on">{% render 'ag-icon', name: 'sound-on', stroke: 2 %}</span></span>
                  {%- elsif block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 375, 500', sizes: '(min-width: 990px) 15vw, 33vw', alt: block.settings.alt }}
                  {%- elsif product.media.size > 0 -%}
                    {%- assign um = forloop.index | modulo: product.media.size -%}
                    {{ product.media[um].preview_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if ugc != blank -%}<div class="agP__ugc">{{ ugc }}</div>{%- endif -%}
        {%- endif -%}

        {%- if s.quote_text != blank -%}
          <figure class="agP__quote"><blockquote>{{ s.quote_text }}</blockquote>{%- if s.quote_name != blank -%}<figcaption>{{ s.quote_name }}</figcaption>{%- endif -%}</figure>
        {%- endif -%}

        {%- capture feats -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="agP__feat" {{ block.shopify_attributes }}>
                <span class="agP__featIc" style="color:{{ block.settings.icon_color }}">{% render 'ag-icon', name: block.settings.icon %}</span>
                <div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.sub }}</span></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if feats != blank -%}<div class="agP__feats">{{ feats }}</div>{%- endif -%}

        {%- if s.show_eta -%}
          <div class="agP__etaWrap" data-ag-eta data-cutoff="{{ s.cutoff_hour }}" data-ship-min="{{ s.ship_min }}" data-ship-max="{{ s.ship_max }}" data-del-min="{{ s.del_min }}" data-del-max="{{ s.del_max }}" data-style="{{ s.date_style }}">
            <p class="agP__eta">{{ s.eta_before }} <b data-eta-left>--h : --m</b> {{ s.eta_after }}</p>
            <div class="agTL">
              <span class="agTL__line" aria-hidden="true"></span>
              <div class="agTL__step"><span class="agTL__ic">{% render 'ag-icon', name: 'bag' %}</span><strong>{{ s.tl_1 }}</strong><span class="agTL__d">{{ s.tl_1_sub }}</span></div>
              <div class="agTL__step"><span class="agTL__ic">{% render 'ag-icon', name: 'truck' %}</span><strong>{{ s.tl_2 }}</strong><span class="agTL__d" data-eta-ship>&nbsp;</span></div>
              <div class="agTL__step"><span class="agTL__ic">{% render 'ag-icon', name: 'box' %}</span><strong>{{ s.tl_3 }}</strong><span class="agTL__d" data-eta-del>&nbsp;</span></div>
            </div>
          </div>
        {%- endif -%}

        {%- capture accs -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="agAcc__item" data-ag-acc{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary class="agAcc__sum"><span style="color:{{ block.settings.icon_color }}">{% render 'ag-icon', name: block.settings.icon %}</span><span>{{ block.settings.title }}</span><span class="agAcc__chev">{% render 'ag-icon', name: 'chevron-down' %}</span></summary>
                <div class="agAcc__body">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if accs != blank -%}<div class="agAcc">{{ accs }}</div>{%- endif -%}

        {%- if s.show_callout and s.callout_text != blank -%}
          <div class="agP__callout agOnlyM">
            <span class="agP__calloutIc">{% render 'ag-icon', name: s.callout_icon %}</span>
            <div>{{ s.callout_text }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if s.show_sticky -%}
    <div class="agSticky" data-ag-sticky aria-hidden="true">
      <div class="agSticky__img">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</div>
      <div class="agSticky__txt"><p class="agSticky__t">{{ s.title_override | default: product.title }}</p><p class="agSticky__p"><span data-ag-atc-price>{{ atc_total | money }}</span></p></div>
      <button type="button" class="agSticky__btn" data-ag-sticky-btn tabindex="-1">{{ s.sticky_btn }}</button>
    </div>
  {%- endif -%}
</section>

