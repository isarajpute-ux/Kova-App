{%- assign s = section.settings -%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.font_family | default: 'Poppins' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap">
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--ag-bg:{{ s.c_bg }};--ag-ink:{{ s.c_ink }};--ag-muted:{{ s.c_muted }};--ag-title:{{ s.c_title }};--ag-wine:{{ s.c_btn }};--ag-wine2:{{ s.c_btn2 }};--ag-soft:{{ s.c_soft }};--ag-line:{{ s.c_line }};--hs-m:{{ s.heading_m }}px;--hs-d:{{ s.heading_d }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
</style>
<section id="ag-{{ section.id }}" class="agS agC">
  <div class="agWrap">
    <h1 class="agC__title">{{ s.heading }}</h1>
    {%- if s.sub != blank -%}<p class="agC__sub">{{ s.sub }}</p>{%- endif -%}
    <div class="agC__grid">
      <div class="agC__form">
        {%- form 'contact', id: 'agContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="agC__ok" role="status">{{ s.success }}</p>
          {%- elsif form.errors -%}
            <div class="agC__bad" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="agC__row agC__row--2">
            <div class="agC__field">
              <label for="agC-name">{{ s.l_name }}</label>
              <input id="agC-name" type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ s.p_name | escape }}">
            </div>
            <div class="agC__field">
              <label for="agC-email">{{ s.l_email }}</label>
              <input id="agC-email" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="{{ s.p_email | escape }}">
            </div>
          </div>
          <div class="agC__field">
            <label for="agC-order">{{ s.l_order }} <small>{{ s.l_optional }}</small></label>
            <input id="agC-order" type="text" name="contact[order_number]" placeholder="{{ s.p_order | escape }}">
          </div>
          <div class="agC__field">
            <label for="agC-msg">{{ s.l_msg }}</label>
            <textarea id="agC-msg" name="contact[body]" required placeholder="{{ s.p_msg | escape }}">{{ form.body }}</textarea>
          </div>
          <button type="submit" class="agP__atc">{{ s.btn }}</button>
        {%- endform -%}
      </div>
      <aside class="agC__card">
        <h3>{{ s.card_title }}</h3>
        <div class="agC__item">{% render 'ag-icon', name: 'mail' %}<div><strong>{{ s.k_email }}</strong><span>{{ s.v_email }}</span></div></div>
        <div class="agC__item">{% render 'ag-icon', name: 'clock' %}<div><strong>{{ s.k_hours }}</strong><span>{{ s.v_hours }}</span></div></div>
        <div class="agC__item">{% render 'ag-icon', name: 'chat' %}<div><strong>{{ s.k_reply }}</strong><span>{{ s.v_reply }}</span></div></div>
        <div class="agC__item">{% render 'ag-icon', name: 'shield' %}<div><strong>{{ s.k_warranty }}</strong><span>{{ s.v_warranty }}</span></div></div>
      </aside>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AuraGlow contact",
  "tag": "div",
  "class": "ag-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Questions about sizing, shipping or your order? Send us a message and a real person will reply." },
    { "type": "text", "id": "font_family", "label": "Font (Google Font name)", "default": "Poppins" },
    { "type": "range", "id": "heading_m", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "heading_d", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 40 },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "l_name", "label": "Name label", "default": "Full name" },
    { "type": "text", "id": "p_name", "label": "Name placeholder", "default": "Jane Doe" },
    { "type": "text", "id": "l_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "p_email", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "text", "id": "l_order", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "l_optional", "label": "Optional tag", "default": "(optional)" },
    { "type": "text", "id": "p_order", "label": "Order number placeholder", "default": "#1001" },
    { "type": "text", "id": "l_msg", "label": "Message label", "default": "How can we help?" },
    { "type": "text", "id": "p_msg", "label": "Message placeholder", "default": "Tell us what's going on…" },
    { "type": "text", "id": "btn", "label": "Button text", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks! We got your message and will reply within 24 hours." },
    { "type": "header", "content": "Good to know card" },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "Good to know" },
    { "type": "text", "id": "k_email", "label": "Row 1 title", "default": "Email" },
    { "type": "text", "id": "v_email", "label": "Row 1 text", "default": "help@yourdomain.com" },
    { "type": "text", "id": "k_hours", "label": "Row 2 title", "default": "Hours" },
    { "type": "text", "id": "v_hours", "label": "Row 2 text", "default": "Mon–Sat, 9am–6pm (CT)" },
    { "type": "text", "id": "k_reply", "label": "Row 3 title", "default": "Typical reply" },
    { "type": "text", "id": "v_reply", "label": "Row 3 text", "default": "Within 24 hours" },
    { "type": "text", "id": "k_warranty", "label": "Row 4 title", "default": "Warranty" },
    { "type": "text", "id": "v_warranty", "label": "Row 4 text", "default": "30-day money-back guarantee" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "c_ink", "label": "Text", "default": "#1B1B1B" },
    { "type": "color", "id": "c_muted", "label": "Muted text", "default": "#6F6F6F" },
    { "type": "color", "id": "c_title", "label": "Heading", "default": "#5A1F2E" },
    { "type": "color", "id": "c_btn", "label": "Button (left)", "default": "#4A1825" },
    { "type": "color", "id": "c_btn2", "label": "Button (right)", "default": "#7A3446" },
    { "type": "color", "id": "c_soft", "label": "Card background", "default": "#F6EBE8" },
    { "type": "color", "id": "c_line", "label": "Borders", "default": "#EADFDC" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "AuraGlow contact" } ]
}
{% endschema %}
