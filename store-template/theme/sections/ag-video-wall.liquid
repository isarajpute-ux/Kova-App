{%- assign s = section.settings -%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
{{ 'ag-video.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.font_family | default: 'Poppins' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap">
<script src="{{ 'ag-sternify.js' | asset_url }}" defer="defer"></script>
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--ag-bg:{{ s.c_bg }};--ag-ink:{{ s.c_ink }};--ag-muted:{{ s.c_sub }};--card-m:{{ s.card_m }}vw;--card-d:{{ s.card_d }}px;--r:{{ s.radius }}px;--hs-m:{{ s.heading_m }}px;--hs-d:{{ s.heading_d }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
</style>
<section id="ag-{{ section.id }}" class="agS agVW" data-ag-vw>
  {%- if s.heading != blank or s.sub != blank -%}
    <div class="agWrap agVW__head">
      {%- if s.heading != blank -%}<h2 class="agVW__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.sub != blank -%}<p class="agVW__sub">{{ s.sub }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="agVW__wrap">
    <button type="button" class="agVW__nav agVW__nav--prev" data-vw-prev aria-label="Previous videos">{% render 'ag-icon', name: 'chevron-left', stroke: 2 %}</button>
    <div class="agVW__track">
      {%- for block in section.blocks -%}
        <div class="agVW__card" data-ag-vcard {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '480x', class: 'agVid' }}
            <span class="agVid__snd" aria-hidden="true"><span class="off">{% render 'ag-icon', name: 'sound-off', stroke: 2 %}</span><span class="on">{% render 'ag-icon', name: 'sound-on', stroke: 2 %}</span></span>
          {%- elsif block.settings.image != blank -%}
            {%- assign calt = block.settings.caption | escape -%}
            {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: calt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'agVW__ph' }}
          {%- endif -%}
          {%- if s.show_captions and block.settings.caption != blank or s.show_captions and block.settings.stars -%}
            <div class="agVW__cap">
              {%- if block.settings.stars -%}{% render 'ag-stars', rating: 5, star_color: s.c_star, star_size: 13 %}{%- endif -%}
              {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <button type="button" class="agVW__nav agVW__nav--next" data-vw-next aria-label="More videos">{% render 'ag-icon', name: 'chevron-right', stroke: 2 %}</button>
  </div>
</section>
{% schema %}
{
  "name": "AuraGlow video wall",
  "tag": "div",
  "class": "ag-section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it glow in real homes" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Tap any video for sound" },
    { "type": "text", "id": "font_family", "label": "Font (Google Font name)", "default": "Poppins" },
    { "type": "range", "id": "heading_m", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "heading_d", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "card_m", "label": "Video width on mobile (% of screen)", "min": 40, "max": 90, "step": 2, "unit": "%", "default": 62 },
    { "type": "range", "id": "card_d", "label": "Video width on desktop", "min": 160, "max": 340, "step": 10, "unit": "px", "default": 230 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions & stars", "default": true },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "c_ink", "label": "Heading colour", "default": "#141414" },
    { "type": "color", "id": "c_sub", "label": "Subheading colour", "default": "#6F6F6F" },
    { "type": "color", "id": "c_star", "label": "Star colour", "default": "#E0A82E" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "clip", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Video (plays muted on loop — tap for sound)" },
      { "type": "image_picker", "id": "image", "label": "Image (used when no video is set)" },
      { "type": "text", "id": "caption", "label": "Caption" },
      { "type": "checkbox", "id": "stars", "label": "Show 5 stars", "default": true } ] }
  ],
  "presets": [ { "name": "AuraGlow video wall", "blocks": [ { "type": "clip" }, { "type": "clip" }, { "type": "clip" } ] } ]
}
{% endschema %}
