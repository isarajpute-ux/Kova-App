{%- assign s = section.settings -%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.heading_font | default: 'DM Serif Display' | replace: ' ', '+' }}&family={{ s.font_family | default: 'Poppins' | replace: ' ', '+' }}:wght@400;500;600&display=swap">
<script src="{{ 'ag-sternify.js' | asset_url }}" defer="defer"></script>
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--ag-serif:'{{ s.heading_font | default: 'DM Serif Display' }}',Georgia,serif;--ag-bg:{{ s.c_bg }};--ag-ink:{{ s.c_ink }};--accent:{{ s.c_accent }};--line:{{ s.c_line }};--maxw:{{ s.max_width }}px;--hs-m:{{ s.heading_m }}px;--hs-d:{{ s.heading_d }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
</style>
<section id="ag-{{ section.id }}" class="agS agF">
  <div class="agWrap">
    <div class="agF__in">
      {%- if s.heading != blank -%}<h2 class="agF__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.sub != blank -%}<p class="agF__sub">{{ s.sub }}</p>{%- endif -%}
      <div class="agF__list">
        {%- for block in section.blocks -%}
          <details class="agF__item" data-ag-acc{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="agF__q"><span class="agF__ic">{% render 'ag-icon', name: s.icon, stroke: 2 %}</span><span>{{ block.settings.q }}</span><span class="agF__chev">{% render 'ag-icon', name: 'chevron-down' %}</span></summary>
            <div class="agF__a">{{ block.settings.a }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AuraGlow FAQ",
  "tag": "div",
  "class": "ag-section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need to know" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Shipping, setup, safety and returns — answered in one place." },
    { "type": "text", "id": "heading_font", "label": "Heading font (Google Font name)", "default": "DM Serif Display" },
    { "type": "text", "id": "font_family", "label": "Body font (Google Font name)", "default": "Poppins" },
    { "type": "range", "id": "heading_m", "label": "Heading size (mobile)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "heading_d", "label": "Heading size (desktop)", "min": 28, "max": 80, "step": 1, "unit": "px", "default": 60 },
    { "type": "select", "id": "icon", "label": "Question icon", "default": "check-circle", "options": [ { "value": "check-circle", "label": "Check circle" }, { "value": "check-circle-fill", "label": "Filled check" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "snowflake", "label": "Snowflake" }, { "value": "star", "label": "Star" }, { "value": "tree", "label": "Tree" } ] },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 860 },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#FFFCF7" },
    { "type": "color", "id": "c_ink", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "c_accent", "label": "Icon colour", "default": "#C8102E" },
    { "type": "color", "id": "c_line", "label": "Divider", "default": "#EADFCE" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "How do I use it?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Drape, plug, done.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false } ] }
  ],
  "presets": [ { "name": "AuraGlow FAQ", "blocks": [ { "type": "qa" } ] } ]
}
{% endschema %}
