{%- liquid
  assign s = section.settings
  case s.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase
-%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ s.font_family | default: 'Poppins' | replace: ' ', '+' }}:wght@400;500;600;700&display=swap">
<script src="{{ 'ag-sternify.js' | asset_url }}" defer="defer"></script>
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--ag-bg:{{ s.c_bg }};--ag-ink:{{ s.c_ink }};--ag-muted:{{ s.c_text }};--tab-bg:{{ s.c_tabs_bg }};--tab-active:{{ s.c_active }};--ratio:{{ ratio }};--hs-m:{{ s.heading_m }}px;--hs-d:{{ s.heading_d }}px;--img-r:{{ s.img_radius }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
</style>
<section id="ag-{{ section.id }}" class="agS agT" data-ag-tabs>
  <div class="agWrap">
    {%- if s.heading != blank -%}<h2 class="agT__title">{{ s.heading }}</h2>{%- endif -%}
    <div class="agT__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="agT__tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    <div class="agT__stage">
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="agT__arrow agT__arrow--prev" data-tab-prev aria-label="Previous">{% render 'ag-icon', name: 'chevron-left', stroke: 2 %}</button>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <div class="agT__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" data-panel="{{ forloop.index0 }}">
          <div class="agT__text">
            <h3>{{ block.settings.heading }}</h3>
            <div class="agT__rte">{{ block.settings.text }}</div>
          </div>
          <div class="agT__media">
            {%- if block.settings.image != blank -%}
              {%- assign ialt = block.settings.heading | escape -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 40vw, 100vw', alt: ialt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'agT__ph' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="agT__arrow agT__arrow--next" data-tab-next aria-label="Next">{% render 'ag-icon', name: 'chevron-right', stroke: 2 %}</button>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AuraGlow tabs",
  "tag": "div",
  "class": "ag-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One tree, three moods" },
    { "type": "text", "id": "font_family", "label": "Font (Google Font name)", "default": "Poppins" },
    { "type": "range", "id": "heading_m", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "heading_d", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "square", "options": [ { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" } ] },
    { "type": "range", "id": "img_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "c_ink", "label": "Heading colour", "default": "#141414" },
    { "type": "color", "id": "c_text", "label": "Body text colour", "default": "#4A4A4A" },
    { "type": "color", "id": "c_tabs_bg", "label": "Tab bar background", "default": "#F2EFE9" },
    { "type": "color", "id": "c_active", "label": "Active tab border", "default": "#1F6B3A" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Classic" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Warm, timeless glow" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pure warm white that makes the whole room feel like Christmas Eve.</p>" },
      { "type": "image_picker", "id": "image", "label": "Image" } ] }
  ],
  "presets": [ { "name": "AuraGlow tabs", "blocks": [ { "type": "tab" }, { "type": "tab", "settings": { "label": "Festive" } }, { "type": "tab", "settings": { "label": "Modern" } } ] } ]
}
{% endschema %}
