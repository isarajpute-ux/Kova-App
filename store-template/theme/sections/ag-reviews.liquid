{%- assign s = section.settings -%}
{{ 'ag-sternify.css' | asset_url | stylesheet_tag }}
{{ 'ag-xmas.css' | asset_url | stylesheet_tag }}
<style>
  #ag-{{ section.id }}{--ag-font:'{{ s.font_family | default: 'Poppins' }}',sans-serif;--bg:{{ s.c_bg }};--ink:{{ s.c_ink }};--line:{{ s.c_line }};--star:{{ s.c_star }};--hs-m:{{ s.heading_m }}px;--hs-d:{{ s.heading_d }}px;padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px;scroll-margin-top:80px}
</style>
<section id="reviews" class="agS"><div id="ag-{{ section.id }}" class="agRv">
  <div class="agWrap">
    <div class="agRv__top">
      {%- if s.heading != blank -%}<h2 class="agRv__title">{{ s.heading }}</h2>{%- endif -%}
      <div class="agRv__score"><b>{{ s.rating }}</b>{% render 'ag-stars', rating: s.rating, star_color: s.c_star, star_size: 18 %}<span>{{ s.count_text }}</span></div>
      {%- if s.show_bars -%}
      <div class="agRv__bars">
        {%- assign pcts = s.bars | split: ',' -%}
        {%- for p in pcts -%}{%- assign st = 6 | minus: forloop.index -%}
        <div class="agRv__bar"><span>{{ st }} ★</span><i><span style="width:{{ p | strip }}%"></span></i><span>{{ p | strip }}%</span></div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    <div class="agRv__list" data-rv-list>
      {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <article class="agRv__card" {% if forloop.index > s.initial %}hidden data-rv-more{% endif %} {{ block.shopify_attributes }}>
        <div class="agRv__head">
          <span class="agRv__av">{%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{%- assign nm = b.name | split: ' ' -%}{{ nm[0] | slice: 0 }}{{ nm[1] | slice: 0 }}{%- endif -%}</span>
          <div><div class="agRv__name">{{ b.name }}</div><div class="agRv__meta">{{ b.location }}{% if b.location != blank and b.date != blank %} · {% endif %}{{ b.date }}</div></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">{% render 'ag-stars', rating: b.rating, star_color: s.c_star, star_size: 14 %}{%- if b.verified -%}<span class="agRv__ver">{% render 'ag-icon', name: 'check-circle-fill' %}Verified buyer</span>{%- endif -%}</div>
        {%- if b.title != blank -%}<div class="agRv__t">{{ b.title }}</div>{%- endif -%}
        <p class="agRv__x">{{ b.text }}</p>
        {%- if b.image != blank -%}<div class="agRv__img">{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: b.name }}</div>{%- endif -%}
      </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > s.initial -%}
    <button type="button" class="agRv__more" onclick="this.parentNode.querySelectorAll('[data-rv-more]').forEach(function(e){e.hidden=false});this.remove()">{{ s.more_text }}</button>
    {%- endif -%}
  </div>
</div></section>
{% schema %}
{
  "name": "AuraGlow reviews",
  "tag": "div",
  "class": "ag-section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What families are saying" },
    { "type": "range", "id": "rating", "label": "Average rating", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "count_text", "label": "Review count text", "default": "Based on 1,547 reviews" },
    { "type": "checkbox", "id": "show_bars", "label": "Show rating bars", "default": true },
    { "type": "text", "id": "bars", "label": "Bar % for 5,4,3,2,1 stars (comma separated)", "default": "89,8,2,1,0" },
    { "type": "range", "id": "initial", "label": "Reviews shown before 'Show more'", "min": 2, "max": 30, "step": 1, "default": 6 },
    { "type": "text", "id": "more_text", "label": "Show more button", "default": "Show more reviews" },
    { "type": "text", "id": "font_family", "label": "Font", "default": "Poppins" },
    { "type": "range", "id": "heading_m", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "heading_d", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 40 },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#FFFCF7" },
    { "type": "color", "id": "c_ink", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "c_line", "label": "Card border", "default": "#EEE6DC" },
    { "type": "color", "id": "c_star", "label": "Stars", "default": "#E0A82E" },
    { "type": "range", "id": "pad_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
      { "type": "text", "id": "location", "label": "Location", "default": "" },
      { "type": "text", "id": "date", "label": "Date", "default": "" },
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Review", "default": "Write the review here." },
      { "type": "image_picker", "id": "image", "label": "Customer photo (optional)" },
      { "type": "image_picker", "id": "avatar", "label": "Profile picture (blank = initials)" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer badge", "default": true } ] }
  ],
  "presets": [ { "name": "AuraGlow reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
