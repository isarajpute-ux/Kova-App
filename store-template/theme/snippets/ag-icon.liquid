{%- liquid
  assign sw = stroke | default: 1.6
-%}
{%- capture a -%}viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="agI"{%- endcapture -%}
{%- case name -%}
  {%- when 'clock' -%}<svg {{ a }}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg>
  {%- when 'leaf' -%}<svg {{ a }}><path d="M5 19C5 10.5 11 5 20 4.5 20 13.5 14 19.5 6 19.5"/><path d="M5 19.5c2.8-4 6-6.6 9.5-8"/></svg>
  {%- when 'heart' -%}<svg {{ a }}><path d="M12 20s-7.5-4.6-7.5-10.4A4.1 4.1 0 0 1 12 7.2a4.1 4.1 0 0 1 7.5 2.4C19.5 15.4 12 20 12 20z"/></svg>
  {%- when 'heart-fill' -%}<svg {{ a }}><path fill="currentColor" d="M12 20s-7.5-4.6-7.5-10.4A4.1 4.1 0 0 1 12 7.2a4.1 4.1 0 0 1 7.5 2.4C19.5 15.4 12 20 12 20z"/></svg>
  {%- when 'box' -%}<svg {{ a }}><path d="M3.5 7.5 12 3.2l8.5 4.3v9L12 20.8l-8.5-4.3z"/><path d="M3.5 7.5 12 11.8l8.5-4.3M12 11.8v9M7.8 5.4l8.5 4.3"/></svg>
  {%- when 'truck' -%}<svg {{ a }}><path d="M2.5 6.5h11v9.5h-11zM13.5 9.5h4l3.5 3.8V16h-7.5"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'bag' -%}<svg {{ a }}><path d="M5 8.5h14l-1.2 11.5H6.2z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
  {%- when 'check' -%}<svg {{ a }}><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'check-circle' -%}<svg {{ a }}><circle cx="12" cy="12" r="9.2"/><path d="m8 12.4 2.8 2.8 5.4-5.8"/></svg>
  {%- when 'check-circle-fill' -%}<svg {{ a }}><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none"/><path d="m7.6 12.4 3 3 5.8-6.2" stroke="#fff" stroke-width="2.2"/></svg>
  {%- when 'bulb' -%}<svg {{ a }}><path d="M9.5 18h5M10.3 21h3.4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2v.3h5V16c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>
  {%- when 'phone' -%}<svg {{ a }}><rect x="6.8" y="2.5" width="10.4" height="19" rx="2.6"/><path d="M10.8 18.5h2.4"/></svg>
  {%- when 'sparkle' -%}<svg {{ a }}><path d="M11 3.5 12.9 9l5.6 1.9-5.6 1.9L11 18.4l-1.9-5.6-5.6-1.9L9.1 9z"/><path d="M18.5 15.5l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z"/></svg>
  {%- when 'shield' -%}<svg {{ a }}><path d="M12 3 19.5 6v6c0 4.4-3.2 7.8-7.5 9-4.3-1.2-7.5-4.6-7.5-9V6z"/><path d="m9 12 2.2 2.2L15.2 10"/></svg>
  {%- when 'gift' -%}<svg {{ a }}><rect x="3.5" y="8" width="17" height="4.2" rx="1"/><path d="M5.3 12.2V21h13.4v-8.8M12 8v13"/><path d="M12 8C10.4 5 6.8 4.6 6.8 6.7 6.8 8.1 9.3 8 12 8zm0 0c1.6-3 5.2-3.4 5.2-1.3 0 1.4-2.5 1.3-5.2 1.3z"/></svg>
  {%- when 'tree' -%}<svg {{ a }}><path d="M12 2.8 16.6 8.5h-2.4l3.9 5.2h-2.8l3.4 4.6H5.3l3.4-4.6H5.9l3.9-5.2H7.4z"/><path d="M12 18.3v3"/></svg>
  {%- when 'snowflake' -%}<svg {{ a }}><path d="M12 2.5v19M3.8 7.2l16.4 9.6M20.2 7.2 3.8 16.8"/><path d="m9.4 4.2 2.6 1.9 2.6-1.9M9.4 19.8l2.6-1.9 2.6 1.9"/></svg>
  {%- when 'bolt' -%}<svg {{ a }}><path d="M13.2 2.5 4.5 13.8h6.7l-.9 7.7 8.7-11.3h-6.7z"/></svg>
  {%- when 'return' -%}<svg {{ a }}><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5v4.3h4.3"/></svg>
  {%- when 'star' -%}<svg {{ a }}><path d="m12 3.2 2.7 5.5 6 .9-4.35 4.25 1 6L12 17l-5.35 2.85 1-6L3.3 9.6l6-.9z"/></svg>
  {%- when 'plug' -%}<svg {{ a }}><path d="M9 2.5V7M15 2.5V7M7 7h10v3.8a5 5 0 0 1-10 0z"/><path d="M12 15.8v5.7"/></svg>
  {%- when 'lock' -%}<svg {{ a }}><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
  {%- when 'dot' -%}<svg {{ a }}><circle cx="12" cy="12" r="7" fill="currentColor" stroke="none"/></svg>
  {%- when 'users' -%}<svg {{ a }}><circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="16.8" cy="9.2" r="2.6"/><path d="M15.6 14.6c2.6-.3 4.4 1.3 4.9 4.4"/></svg>
  {%- when 'palette' -%}<svg {{ a }}><path d="M12 3.5a8.5 8.5 0 1 0 0 17c1.3 0 1.8-.9 1.4-1.9-.5-1.2.3-2.3 1.6-2.3h1.8a3.7 3.7 0 0 0 3.7-3.7C20.5 7.6 16.7 3.5 12 3.5z"/><circle cx="7.8" cy="11" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="7.8" r="1"/></svg>
  {%- when 'moon' -%}<svg {{ a }}><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/></svg>
  {%- when 'chevron-left' -%}<svg {{ a }}><path d="m14.5 6-6 6 6 6"/></svg>
  {%- when 'chevron-right' -%}<svg {{ a }}><path d="m9.5 6 6 6-6 6"/></svg>
  {%- when 'chevron-down' -%}<svg {{ a }}><path d="m6 9.5 6 6 6-6"/></svg>
  {%- when 'close' -%}<svg {{ a }}><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>
  {%- when 'copy' -%}<svg {{ a }}><rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2"/><path d="M15.5 8.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5"/></svg>
  {%- when 'drag' -%}<svg {{ a }}><path d="m9 7-5 5 5 5M15 7l5 5-5 5"/></svg>
  {%- when 'mail' -%}<svg {{ a }}><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
  {%- when 'chat' -%}<svg {{ a }}><path d="M4.5 5.5h15v10h-8l-4.5 3.5v-3.5H4.5z"/></svg>
  {%- when 'sound-off' -%}<svg {{ a }}><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="m16 9.5 5 5M21 9.5l-5 5"/></svg>
  {%- when 'sound-on' -%}<svg {{ a }}><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg>
  {%- when 'play' -%}<svg {{ a }}><path fill="currentColor" stroke="none" d="M8 5.5v13l11-6.5z"/></svg>
{%- endcase -%}
