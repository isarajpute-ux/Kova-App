{
  "name": "Cart drawer (AuraGlow)",
  "settings": [
    {
      "type": "paragraph",
      "content": "Customises the slide-out cart drawer. Requires Cart > Cart type = Drawer."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "ag_cd_accent",
      "label": "Accent color (Apply & Checkout buttons)",
      "default": "#C8102E"
    },
    {
      "type": "color",
      "id": "ag_cd_accent_text",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ag_cd_pink_bg",
      "label": "Timer bar background",
      "default": "#FBE3E1"
    },
    {
      "type": "color",
      "id": "ag_cd_social_bg",
      "label": "Social proof row background",
      "default": "#FDF0EE"
    },
    {
      "type": "color",
      "id": "ag_cd_text_color",
      "label": "Text color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "ag_cd_muted_color",
      "label": "Secondary text color",
      "default": "#8A8A8A"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_icon",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "text",
      "id": "ag_cd_title",
      "label": "Title",
      "default": "Your Cart"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_count",
      "label": "Show item count after title, e.g. (2)",
      "default": true
    },
    {
      "type": "header",
      "content": "Social proof row"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_social",
      "label": "Show social proof row",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ag_cd_avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "ag_cd_avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "ag_cd_avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "range",
      "id": "ag_cd_avatar_size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Avatar size",
      "default": 32
    },
    {
      "type": "select",
      "id": "ag_cd_avatar_shape",
      "label": "Avatar shape",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "rounded",
          "label": "Rounded square"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "ag_cd_avatar_overlap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Avatar overlap",
      "default": 10
    },
    {
      "type": "inline_richtext",
      "id": "ag_cd_social_text",
      "label": "Social proof text",
      "info": "Use bold for the names.",
      "default": "<strong>Sara, Maddie, Tyler</strong> and 3026 others are a fan of AuraGlow"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_badge",
      "label": "Show brand badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ag_cd_badge_image",
      "label": "Badge image",
      "info": "Square logo, e.g. a review platform icon. Leave empty to show a star."
    },
    {
      "type": "color",
      "id": "ag_cd_badge_bg",
      "label": "Badge background",
      "default": "#00B67A"
    },
    {
      "type": "header",
      "content": "Reserved timer"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_timer",
      "label": "Show reserved timer",
      "default": true
    },
    {
      "type": "range",
      "id": "ag_cd_timer_minutes",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "min",
      "label": "Countdown length",
      "info": "Restarts automatically when it reaches 00:00.",
      "default": 10
    },
    {
      "type": "text",
      "id": "ag_cd_timer_before",
      "label": "Text before timer",
      "default": "Your Cart is reserved for"
    },
    {
      "type": "text",
      "id": "ag_cd_timer_after",
      "label": "Text after timer",
      "default": "Minutes"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_banner",
      "label": "Show banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ag_cd_banner_image",
      "label": "Banner image",
      "info": "Wide lifestyle photo, about 900 x 360 px. Keep the right side calm for the text."
    },
    {
      "type": "range",
      "id": "ag_cd_banner_height",
      "min": 100,
      "max": 220,
      "step": 10,
      "unit": "px",
      "label": "Banner height",
      "default": 150
    },
    {
      "type": "color",
      "id": "ag_cd_banner_bg",
      "label": "Banner placeholder / text shade color",
      "default": "#3E1520"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_banner_overlay",
      "label": "Show overlay text on image",
      "info": "Always shown on the placeholder when no image is selected.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "ag_cd_banner_headline",
      "label": "Overlay headline",
      "default": "Rated <strong>Excellent</strong>"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_banner_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "color",
      "id": "ag_cd_banner_star_color",
      "label": "Star box color",
      "default": "#00B67A"
    },
    {
      "type": "inline_richtext",
      "id": "ag_cd_banner_subtext",
      "label": "Overlay sub text",
      "default": "Over <strong>3,000</strong> reviews"
    },
    {
      "type": "header",
      "content": "Line items"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_variant",
      "label": "Show variant title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_compare",
      "label": "Show compare-at price struck through",
      "default": true
    },
    {
      "type": "range",
      "id": "ag_cd_image_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Product image corner radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Free shipping bar"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_fs",
      "label": "Show free shipping bar",
      "default": true
    },
    {
      "type": "number",
      "id": "ag_cd_fs_threshold",
      "label": "Free shipping threshold",
      "info": "In your store currency, e.g. 50 = $50.00. Should match your shipping rates.",
      "default": 50
    },
    {
      "type": "text",
      "id": "ag_cd_fs_text",
      "label": "Progress text",
      "info": "[amount] is replaced with the amount still needed.",
      "default": "⏳ Add [amount] to unlock Free Shipping"
    },
    {
      "type": "text",
      "id": "ag_cd_fs_success",
      "label": "Unlocked text",
      "default": "🎉 You've unlocked Free Shipping!"
    },
    {
      "type": "text",
      "id": "ag_cd_fs_label",
      "label": "Label under the bar end",
      "default": "Free shipping"
    },
    {
      "type": "color",
      "id": "ag_cd_fs_bar_color",
      "label": "Progress bar color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "ag_cd_fs_track_color",
      "label": "Progress track color",
      "default": "#E4E4E4"
    },
    {
      "type": "header",
      "content": "Discount code"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_discount",
      "label": "Show discount code field",
      "default": true
    },
    {
      "type": "text",
      "id": "ag_cd_discount_label",
      "label": "Label",
      "default": "Discount code"
    },
    {
      "type": "text",
      "id": "ag_cd_discount_placeholder",
      "label": "Placeholder",
      "default": "Enter discount code"
    },
    {
      "type": "text",
      "id": "ag_cd_discount_button",
      "label": "Apply button text",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "ag_cd_discount_success",
      "label": "Success message",
      "default": "Discount code applied!"
    },
    {
      "type": "text",
      "id": "ag_cd_discount_error",
      "label": "Error message",
      "default": "This code isn't valid for your cart."
    },
    {
      "type": "header",
      "content": "Subtotal & checkout"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_subtotal",
      "label": "Show subtotal row",
      "default": true
    },
    {
      "type": "text",
      "id": "ag_cd_subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_show_tax_note",
      "label": "Show taxes & shipping note",
      "default": false
    },
    {
      "type": "text",
      "id": "ag_cd_checkout_text",
      "label": "Checkout button text",
      "default": "Checkout"
    },
    {
      "type": "checkbox",
      "id": "ag_cd_checkout_price",
      "label": "Show total on checkout button",
      "default": true
    }
  ]
}
